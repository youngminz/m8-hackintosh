+// ---- Runtime PMFW mailbox access: sysctl debug.rmb_smu (root writes, anyone reads).
+// Write (msg << 32) | arg to send one message; read back (response << 32) | result argument.
+// Only clock queries and clock limit messages are accepted (no resets or power down).
+namespace {
+IOLock *gSmuLock;
+uint64_t gSmuLast;
+
+bool smuMsgAllowed(uint32_t msg) {
+	switch (msg) {
+	case 0x01:  // TestMessage
+	case 0x02:  // GetSmuVersion
+	case 0x03:  // GetDriverIfVersion
+	case 0x08:  // SetHardMinVcn (VCLK MHz << 16 | DCLK MHz)
+	case 0x09:  // SetSoftMinGfxclk
+	case 0x12:  // GetEnabledSmuFeatures
+	case 0x13:  // SetHardMinSocclkByFreq
+	case 0x14:  // SetSoftMinFclk
+	case 0x15:  // SetSoftMinVcn
+	case 0x17:  // GetGfxclkFrequency
+	case 0x18:  // GetFclkFrequency
+	case 0x1B:  // SetSoftMaxGfxClk
+	case 0x1C:  // SetHardMinGfxClk
+	case 0x1D:  // SetSoftMaxSocclkByFreq
+	case 0x1E:  // SetSoftMaxFclkByFreq
+	case 0x1F:  // SetSoftMaxVcn
+	case 0x23:  // SetHardMinFclkByFreq
+	case 0x24:  // SetSoftMinSocclkByFreq
+		return true;
+	default:
+		return false;
+	}
+}
+
+int smuSysctl(struct sysctl_oid *, void *, int, struct sysctl_req *req) {
+	uint64_t in = 0;
+	int err = SYSCTL_OUT(req, &gSmuLast, sizeof(gSmuLast));
+	if (err || !req->newptr)
+		return err;
+	if ((err = SYSCTL_IN(req, &in, sizeof(in))))
+		return err;
+	uint32_t msg = static_cast<uint32_t>(in >> 32), arg = static_cast<uint32_t>(in);
+	if (!smuMsgAllowed(msg) || !gSmuLock)
+		return EPERM;
+	IOLockLock(gSmuLock);
+	uint32_t resp = sendMsg(msg, arg);
+	gSmuLast = (static_cast<uint64_t>(resp) << 32) | arg;
+	IOLockUnlock(gSmuLock);
+	LOG("smu: sysctl msg %#x arg %#x -> resp %u, arg %#x", msg, static_cast<uint32_t>(in), resp, arg);
+	return 0;
+}
+
+SYSCTL_PROC(_debug, OID_AUTO, rmb_smu, CTLTYPE_QUAD | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_KERN, nullptr, 0,
+            smuSysctl, "Q", "RembrandtGfx PMFW mailbox: write (msg<<32)|arg, read (resp<<32)|arg");
+}  // namespace
+
+// ---- VCN clock floor while decoding (sysctl debug.rmb_vcnboost: 0 off, 1 auto (default), 2 always).
+// With a display lit, PMFW keeps VCLK/DCLK at the lowest level (400/400 MHz): 1080p HEVC decodes at
+// ~130 fps instead of ~330. Linux leaves VCN DPM to PMFW too; here we ask for a hard minimum while
+// the decode ring's write pointer moves, and drop it after BoostIdleMs without new work.
+namespace {
+constexpr uint32_t VcnRbWptr = 0x80e1;              // decode ring write pointer (see vcn.cpp vcnring)
+constexpr uint32_t BoostArg = (1600u << 16) | 1600; // PMFW clamps to the top level (1440/1284 MHz)
+constexpr int BoostPollMs = 100, BoostIdleMs = 3000;
+int gVcnBoost = 1;
+uint32_t gBoostOns;
+SYSCTL_INT(_debug, OID_AUTO, rmb_vcnboost, CTLFLAG_RW | CTLFLAG_KERN, &gVcnBoost, 0,
+           "RembrandtGfx VCN clock floor: 0 off, 1 while decoding, 2 always");
+SYSCTL_UINT(_debug, OID_AUTO, rmb_vcnboost_ons, CTLFLAG_RD | CTLFLAG_KERN, &gBoostOns, 0,
+            "RembrandtGfx VCN clock floor: times raised");
+
+bool setVcnFloor(bool on) {
+	uint32_t arg = on ? BoostArg : 0;
+	IOLockLock(gSmuLock);
+	auto resp = sendMsg(0x08, arg);  // SetHardMinVcn
+	IOLockUnlock(gSmuLock);
+	if (gBoostOns < 3 || !on)
+		LOG("vcnboost: %s (resp %u, clocks %u/%u MHz)", on ? "raised" : "released", resp, arg >> 16, arg & 0xffff);
+	return resp == 1;
+}
+
+void vcnBoostThread(void *, wait_result_t) {
+	bool on = false;
+	uint32_t last = mmioRead(VcnRbWptr);
+	int idleMs = 0;
+	for (;;) {
+		IOSleep(BoostPollMs);
+		uint32_t w = mmioRead(VcnRbWptr);
+		bool busy = w != last && w != 0xFFFFFFFF;
+		last = w;
+		idleMs = busy ? 0 : idleMs + BoostPollMs;
+		bool want = gVcnBoost == 2 || (gVcnBoost == 1 && idleMs < BoostIdleMs);
+		if (want != on && setVcnFloor(want)) {
+			on = want;
+			if (on)
+				gBoostOns++;
+		}
+	}
+}
+}  // namespace
+
+void vcnBoostStart() {
+	static bool started;
+	thread_t t;
+	if (started || !gSmuLock)
+		return;
+	sysctl_register_oid(&sysctl__debug_rmb_vcnboost);
+	sysctl_register_oid(&sysctl__debug_rmb_vcnboost_ons);
+	if (kernel_thread_start(vcnBoostThread, nullptr, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+		started = true;
+		LOG("vcnboost: started (sysctl debug.rmb_vcnboost=%d)", gVcnBoost);
+	}
+}
