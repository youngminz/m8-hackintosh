+// ---- Wake breadcrumbs (M8 S3 debugging): a stage byte in RTC CMOS RAM (ports 0x70/0x71, index
+// 0x58, sequence count at 0x59), which survives the forced power cycle after a failed wake; the next
+// boot logs "wakecrumb: last stage ..." and resets it to 0xB0.
+//   0x51 WillSleep seen     0x52 entering acpi_sleep_kernel     0x53 acpi_sleep_kernel returned
+//   0x54 dark wake / CPU back message     0x55 HasPoweredOn
+// Ports 0x72/0x73 reach the full 256-byte RTC RAM (0x70 masks bit 7 as the NMI gate).
+static uint8_t cmosRead(uint8_t idx) {
+	uint8_t v;
+	asm volatile("outb %%al, $0x72" : : "a"(idx));
+	asm volatile("inb $0x73, %%al" : "=a"(v));
+	return v;
+}
+static void cmosWrite(uint8_t idx, uint8_t v) {
+	asm volatile("outb %%al, $0x72" : : "a"(idx));
+	asm volatile("outb %%al, $0x73" : : "a"(v));
+}
+// 2026-11-10: after a failed wake and a forced power cycle, 0x58/0x59 read back 3b/01, values this
+// code never writes, so the firmware uses those cells. The stage now goes to several cell pairs and
+// the whole RAM is dumped at the next boot to see which pairs survive.
+static const uint8_t kCrumbCells[] = {0x58, 0x4a, 0x6a, 0x7a, 0xca, 0xea};
+static bool gCrumbOn;  // -rmbwakecrumb: without it nothing here writes CMOS or the wake vector
+void wakeCrumb(uint8_t stage) {
+	if (!gCrumbOn)
+		return;
+	for (uint8_t c : kCrumbCells) {
+		uint8_t seq = cmosRead(c + 1);
+		cmosWrite(c, stage);
+		cmosWrite(c + 1, static_cast<uint8_t>(seq + 1));
+	}
+}
+
+// ---- Wake vector breadcrumbs. The firmware resumes the OS at the FACS waking vector, physical
+// 0x2000 (real_mode_bootstrap_base copied there, CS=0x200 IP=0). Its first 11 bytes are
+//   fa                             cli
+//   2e 67 66 0f 01 15 40 00 00 00  lgdt cs:[0x40]
+// and it ends with mov ecx,[0x2800]; jmp ecx (PROT_MODE_START, acpi_wake_prot).
+// Right before acpi_sleep_kernel this plants
+//   0x2000: jmp 0x2100
+//   0x2100: cli; stage 0x56 -> cells 4a/6a/7a; the lgdt; jmp 0x200b        (real mode reached)
+//   0x2180: stage 0x57 -> cells 4a/6a/7a; mov ecx, <old [0x2800]>; jmp ecx (protected mode reached)
+// and points [0x2800] at 0x2180. The kernel recopies 0x2000..0x204f and [0x2800] when it restarts
+// the other CPUs after a good wake, which removes the patch. Cell ea records the outcome of planting:
+// a1 planted, a0 unexpected bytes at 0x2000 (nothing written).
+static void physPut(IOPhysicalAddress at, const uint8_t *src, size_t n) {
+	for (size_t i = 0; i < n; i++)
+		IOMappedWrite8(at + i, src[i]);
+}
+static void wakeVectorPlant() {
+	static const uint8_t expect[] = {0xfa, 0x2e, 0x67, 0x66, 0x0f, 0x01, 0x15, 0x40, 0x00, 0x00, 0x00};
+	for (size_t i = 0; i < sizeof(expect); i++)
+		if (IOMappedRead8(0x2000 + i) != expect[i]) {
+			cmosWrite(0xea, 0xa0);
+			return;
+		}
+	static const uint8_t real[] = {
+		0xfa,
+		0xb0, 0x4a, 0xe6, 0x72, 0xb0, 0x56, 0xe6, 0x73,
+		0xb0, 0x6a, 0xe6, 0x72, 0xb0, 0x56, 0xe6, 0x73,
+		0xb0, 0x7a, 0xe6, 0x72, 0xb0, 0x56, 0xe6, 0x73,
+		0x2e, 0x67, 0x66, 0x0f, 0x01, 0x15, 0x40, 0x00, 0x00, 0x00,
+		0xe9, 0xe5, 0xfe,  // jmp 0x200b: next ip 0x126, rel16 = 0x0b - 0x126
+	};
+	uint8_t prot[] = {
+		0xb0, 0x4a, 0xe6, 0x72, 0xb0, 0x57, 0xe6, 0x73,
+		0xb0, 0x6a, 0xe6, 0x72, 0xb0, 0x57, 0xe6, 0x73,
+		0xb0, 0x7a, 0xe6, 0x72, 0xb0, 0x57, 0xe6, 0x73,
+		0xb9, 0, 0, 0, 0,  // mov ecx, old [0x2800]
+		0xff, 0xe1,        // jmp ecx
+	};
+	uint32_t old = IOMappedRead32(0x2800);
+	if (old == 0x2180) {  // already planted in an earlier, aborted sleep
+		cmosWrite(0xea, 0xa1);
+		return;
+	}
+	prot[25] = static_cast<uint8_t>(old), prot[26] = static_cast<uint8_t>(old >> 8);
+	prot[27] = static_cast<uint8_t>(old >> 16), prot[28] = static_cast<uint8_t>(old >> 24);
+	physPut(0x2100, real, sizeof(real));
+	physPut(0x2180, prot, sizeof(prot));
+	IOMappedWrite32(0x2800, 0x2180);
+	static const uint8_t jmp[] = {0xe9, 0xfd, 0x00};  // jmp 0x2100: next ip 3, rel16 = 0x100 - 3
+	physPut(0x2000, jmp, sizeof(jmp));
+	cmosWrite(0xea, 0xa1);
+}
+
+static mach_vm_address_t orgAcpiSleepKernel;
+static void wrapAcpiSleepKernel(void *func, void *refcon) {
+	wakeCrumb(0x52);
+	if (gCrumbOn && !checkKernelArgument("-rmbnowakevec"))
+		wakeVectorPlant();
+	FunctionCast(wrapAcpiSleepKernel, orgAcpiSleepKernel)(func, refcon);
+	wakeCrumb(0x53);
+}
+
+// ---- Physical memory dump on request (firmware analysis). If /Users/user/m8/physdump-req holds
+// "<hex address> <hex length>", that range is written to /Users/user/m8/physdump.bin 20 s after the
+// accelerator loads. Used to pull AMI's exported HII database (NVRAM variable HiiDB = size, address).
+static uint64_t hexField(const char *&p) {
+	uint64_t v = 0;
+	while (*p == ' ' || *p == '\n' || *p == 'x' || *p == 'X')
+		p++;
+	for (;; p++) {
+		char c = *p;
+		if (c >= '0' && c <= '9')
+			v = v * 16 + (c - '0');
+		else if (c >= 'a' && c <= 'f')
+			v = v * 16 + (c - 'a' + 10);
+		else if (c >= 'A' && c <= 'F')
+			v = v * 16 + (c - 'A' + 10);
+		else
+			break;
+	}
+	return v;
+}
+static void physDumpThread(void *, wait_result_t) {
+	IOSleep(20000);
+	auto ctx = vfs_context_create(nullptr);
+	vnode_t vp = nullptr;
+	uint64_t addr = 0, len = 0;
+	if (!vnode_open("/Users/user/m8/physdump-req", FREAD, 0, 0, &vp, ctx)) {
+		char buf[48] {};
+		int resid = 0;
+		if (!vn_rdwr(UIO_READ, vp, buf, sizeof(buf) - 1, 0, UIO_SYSSPACE, 0, vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx))) {
+			const char *p = buf;
+			addr = hexField(p);
+			len = hexField(p);
+		}
+		vnode_close(vp, FREAD, ctx);
+	}
+	if (addr && len && len <= 0x4000000) {
+		auto *md = IOMemoryDescriptor::withPhysicalAddress(static_cast<IOPhysicalAddress>(addr), static_cast<IOByteCount>(len), kIODirectionIn);
+		auto *map = md ? md->map() : nullptr;
+		if (map && !vnode_open("/Users/user/m8/physdump.bin", O_CREAT | O_TRUNC | FWRITE, 0644, 0, &vp, ctx)) {
+			auto *src = reinterpret_cast<char *>(map->getVirtualAddress());
+			int err = 0;
+			for (uint64_t off = 0; off < len && !err; off += 0x10000) {
+				int n = static_cast<int>(len - off < 0x10000 ? len - off : 0x10000), resid = 0;
+				err = vn_rdwr(UIO_WRITE, vp, src + off, n, static_cast<off_t>(off), UIO_SYSSPACE, IO_UNIT | IO_NOAUTH,
+				              vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+			}
+			vnode_close(vp, FWRITE, ctx);
+			LOG("physdump: %llx + %llx written, err %d", addr, len, err);
+		}
+		else
+			LOG("physdump: map or open failed for %llx + %llx", addr, len);
+		OSSafeReleaseNULL(map);
+		OSSafeReleaseNULL(md);
+	}
+	vfs_context_rele(ctx);
+}
+
+uint8_t gCrumbStage, gCrumbSeq;
+bool gCrumbHooked;
+static uint8_t gCmosDump[256];
+// Called again later in boot (accelerator load): the first lines are too early for the disk log.
+void wakeCrumbReport() {
+	LOG("wakecrumb: %s, previous boot ended at stage %02x seq %02x (acpi_sleep_kernel hook %s)", gCrumbOn ? "on" : "off",
+	    gCmosDump[0x4a], gCmosDump[0x4b], gCrumbHooked ? "on" : "FAILED");
+	thread_t th = nullptr;
+	if (kernel_thread_start(physDumpThread, nullptr, &th) == KERN_SUCCESS)
+		thread_deallocate(th);
+	for (size_t i = 0; i < sizeof(kCrumbCells); i++)
+		LOG("wakecrumb: cell %02x stage %02x seq %02x", kCrumbCells[i], gCmosDump[kCrumbCells[i]],
+		    gCmosDump[kCrumbCells[i] + 1]);
+	for (int r = 0; r < 256; r += 16) {
+		const uint8_t *d = gCmosDump + r;
+		LOG("wakecrumb: cmos %02x: %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x", r,
+		    d[0], d[1], d[2], d[3], d[4], d[5], d[6], d[7], d[8], d[9], d[10], d[11], d[12], d[13], d[14], d[15]);
+	}
+}
+
+static void wakeCrumbRoute(KernelPatcher &patcher) {
+	for (int i = 0; i < 256; i++)
+		gCmosDump[i] = cmosRead(static_cast<uint8_t>(i));
+	gCrumbStage = gCmosDump[0x58], gCrumbSeq = gCmosDump[0x59];
+	LOG("wakecrumb: last stage %02x seq %02x", gCrumbStage, gCrumbSeq);
+	gCrumbOn = checkKernelArgument("-rmbwakecrumb");
+	for (uint8_t c : kCrumbCells) {
+		if (c == 0x58)  // the firmware owns 0x58/0x59
+			continue;
+		uint8_t v = gCmosDump[c];
+		bool mine = v == 0xB0 || (v >= 0x51 && v <= 0x57) || v == 0xa0 || v == 0xa1;
+		if (gCrumbOn) {
+			cmosWrite(c, 0xB0);
+			cmosWrite(c + 1, 0);
+		}
+		else if (mine) {  // leftovers of an earlier experiment: give the cells back as zero
+			cmosWrite(c, 0);
+			cmosWrite(c + 1, 0);
+		}
+	}
+	KernelPatcher::RouteRequest req {"_acpi_sleep_kernel", wrapAcpiSleepKernel, orgAcpiSleepKernel};
+	if (!patcher.routeMultiple(KernelPatcher::KernelID, &req, 1))
+		LOG("wakecrumb: failed to route acpi_sleep_kernel (err %d)", patcher.getError());
+	else {
+		gCrumbHooked = true;
+		LOG("wakecrumb: acpi_sleep_kernel hooked");
+	}
+	patcher.clearError();
+}
