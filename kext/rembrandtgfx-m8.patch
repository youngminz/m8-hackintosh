+// ---- Wake breadcrumbs (M8 S3 debugging): a stage byte in RTC CMOS RAM (ports 0x70/0x71, index
+// 0x58, sequence count at 0x59), which survives the forced power cycle after a failed wake; the next
+// boot logs "wakecrumb: last stage ..." and resets it to 0xB0.
+//   0x51 WillSleep seen     0x52 entering acpi_sleep_kernel     0x53 acpi_sleep_kernel returned
+//   0x54 dark wake / CPU back message     0x55 HasPoweredOn
+static uint8_t cmosRead(uint8_t idx) {
+	uint8_t v;
+	asm volatile("outb %%al, $0x70" : : "a"(idx));
+	asm volatile("inb $0x71, %%al" : "=a"(v));
+	return v;
+}
+static void cmosWrite(uint8_t idx, uint8_t v) {
+	asm volatile("outb %%al, $0x70" : : "a"(idx));
+	asm volatile("outb %%al, $0x71" : : "a"(v));
+}
+void wakeCrumb(uint8_t stage) {
+	uint8_t seq = cmosRead(0x59);
+	cmosWrite(0x58, stage);
+	cmosWrite(0x59, static_cast<uint8_t>(seq + 1));
+}
+
+static mach_vm_address_t orgAcpiSleepKernel;
+static void wrapAcpiSleepKernel(void *func, void *refcon) {
+	wakeCrumb(0x52);
+	FunctionCast(wrapAcpiSleepKernel, orgAcpiSleepKernel)(func, refcon);
+	wakeCrumb(0x53);
+}
+
+uint8_t gCrumbStage, gCrumbSeq;
+bool gCrumbHooked;
+// Called again later in boot (accelerator load): the first lines are too early for the disk log.
+void wakeCrumbReport() {
+	LOG("wakecrumb: previous boot ended at stage %02x seq %02x (acpi_sleep_kernel hook %s)", gCrumbStage, gCrumbSeq,
+	    gCrumbHooked ? "on" : "FAILED");
+}
+
+static void wakeCrumbRoute(KernelPatcher &patcher) {
+	gCrumbStage = cmosRead(0x58), gCrumbSeq = cmosRead(0x59);
+	LOG("wakecrumb: last stage %02x seq %02x", gCrumbStage, gCrumbSeq);
+	cmosWrite(0x58, 0xB0);
+	cmosWrite(0x59, 0);
+	KernelPatcher::RouteRequest req {"_acpi_sleep_kernel", wrapAcpiSleepKernel, orgAcpiSleepKernel};
+	if (!patcher.routeMultiple(KernelPatcher::KernelID, &req, 1))
+		LOG("wakecrumb: failed to route acpi_sleep_kernel (err %d)", patcher.getError());
+	else {
+		gCrumbHooked = true;
+		LOG("wakecrumb: acpi_sleep_kernel hooked");
+	}
+	patcher.clearError();
+}
